# ─────────────────────────────────────────────────────────────────────────────
# application-secret.yml — 크리덴셜(키·비번·토큰) 전용 단일 소스
#
# 사용:  cp application-secret.yml.example application-secret.yml  → 값 채움
#
#  • 비밀 아닌 설정은 전부 application.yml 에 있음. 여기엔 "진짜 시크릿"만.
#  • 로컬: 기본 프로필 `secret,h2` 부팅 시 자동 로드(파일 없으면 무시). 테스트에선 미로드.
#  • 운영: Cloud Build 가 이 파일을 이미지에 구워넣고(.gcloudignore), 앱이 secret 프로필로 로드.
#    → 이 파일만 고치고 재배포하면 로컬·운영 모두 반영(배포 시 키 파라미터 주입 불필요).
#  • 값 채우기: deploy/pull_secrets.py 로 GCP Secret Manager 에서 내려받거나 수동 입력.
#  • application-secret.yml 은 .gitignore 로 차단됨 — 이 .example 만 git 에 올라간다.
#  • ⚠ 실제 파일은 커밋 안 되는 유일 원본 → 반드시 백업(비번매니저/sops). docs/ENV.md 참고.
#  • 빈 값은 그대로 두면 해당 기능 graceful off.
# ─────────────────────────────────────────────────────────────────────────────

# JWT 서명 키(HS256, >= 32 bytes). 비우면 application.yml 의 dev 기본값 사용.
# 운영 키로 로컬을 맞추려면 주석 해제 후 채움.
#security:
#  jwt:
#    secret: ""

claude:
  api:
    key: ""                 # sk-ant-api...
  oauth:
    token: ""               # sk-ant-oat... (설정 시 Bearer 우선)

mistral:
  api:
    key: ""                 # 무료 마켓 브리핑 합성용

spring:
  mail:
    password: ""            # SMTP 앱 비밀번호 (host/port/username 은 application.yml)
  # 로컬 PostgreSQL 사용 시에만:
  # datasource:
  #   password: ""

toss:
  secret-key: ""            # test_sk_.../live_sk_... (서버 전용, 노출 금지)

oauth:
  google:
    client-secret: ""
  kakao:
    client-secret: ""       # 카카오는 보안키 선택
  naver:
    client-secret: ""

marketdata:
  ecos-key: ""              # 한국은행 ECOS
  reb-key: ""               # 한국부동산원 R-ONE
  data-go-kr-key: ""        # 국토부 RTMS + 거래상대방 실사
  vworld-key: ""            # V-World
  juso-key: ""              # 도로명주소(PNU)

marketfeed:
  ingest-token: ""          # 시장 자동수집 트리거 토큰
